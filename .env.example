# Copia este archivo como .env y usa tus credenciales locales.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tu_usuario
DB_PASSWORD=tu_clave
DB_DATABASE=inventario

# private exige iniciar sesión; demo solo muestra datos ficticios en memoria.
APP_MODE=private
# development permite HTTP local; production exige HTTPS y clave persistente.
APP_ENV=development
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]

# En producción es obligatoria y debe tener al menos 32 caracteres.
# Genera tu propia clave con:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
